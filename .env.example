# ==========================================
# Telegram Video Downloader Configuration Template
# Copy this file to a new file named '.env' and fill in your values.
# ==========================================

# Telegram API Credentials
# Get these from https://my.telegram.org (API Development Tools)
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Maximum download limit. Supports plain bytes (21474836480) or
# human units: 20GB, 1.5GB, 500MB, 10KB, 1TB ... Default is 20 GB.
MAX_TOTAL_SIZE=20GB

# Directory name where downloads will be saved
DOWNLOADS_DIR=downloads